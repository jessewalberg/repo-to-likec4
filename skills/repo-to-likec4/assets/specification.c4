// ============================================================================
//  specification.c4  —  reusable, pre-styled LikeC4 vocabulary
// ----------------------------------------------------------------------------
//  Drop this into every repo's likec4/ folder. It gives a consistent set of
//  element kinds, relationship kinds, tags and a legend, all pre-styled so the
//  diagrams look designed (icons, shapes, semantic colors) without per-repo
//  styling work. Add/remove kinds to fit the repo, but keep the color and
//  shape *semantics* below stable across projects — consistency is what reads
//  as "beautiful".
//
//  COLOR SEMANTICS (do not drift between repos):
//    primary    your code / the system under study
//    secondary  human actors & personas
//    gray       third-party / external systems you don't own
//    indigo     stateful stores (db, cache, object storage)
//    amber      async transport (queues, topics, event buses)
//    green      healthy / new / highlighted-in-a-view
//    red        deprecated / risk / PII-handling (used via tags, per-view)
//    muted      de-emphasized context in a given view
// ============================================================================

specification {

  // ---- Human actors -------------------------------------------------------
  element person {
    notation 'Person / actor'
    style {
      shape person
      color secondary
    }
  }

  // ---- The system under study (used in the Context view) ------------------
  element system {
    notation 'System under study'
    style {
      shape rectangle
      color primary
    }
  }

  // ---- Deployable / runnable units (Container level) ----------------------
  element webapp {
    notation 'Web frontend (SPA / SSR)'
    style {
      shape browser
      color primary
    }
  }
  element mobileapp {
    notation 'Mobile app'
    style {
      shape mobile
      color primary
    }
  }
  element service {
    notation 'Service / API'
    style {
      shape rectangle
      color primary
    }
  }
  element worker {
    notation 'Background worker / job'
    style {
      shape rectangle
      color primary
    }
  }
  element function {
    notation 'Serverless function'
    style {
      shape rectangle
      color primary
      multiple true
    }
  }
  element gateway {
    notation 'API gateway / edge / proxy'
    style {
      shape rectangle
      color primary
    }
  }

  // ---- Internal building blocks (Component level) -------------------------
  element component {
    notation 'Component / module'
    style {
      shape component
      color primary
    }
  }

  // ---- Stateful stores ----------------------------------------------------
  element database {
    notation 'Database'
    style {
      shape cylinder
      color indigo
    }
  }
  element cache {
    notation 'Cache'
    style {
      shape storage
      color indigo
    }
  }
  element bucket {
    notation 'Object storage / blob'
    style {
      shape bucket
      color indigo
    }
  }

  // ---- Async transport ----------------------------------------------------
  element queue {
    notation 'Queue / topic / event bus'
    style {
      shape queue
      color amber
    }
  }

  // ---- Things you don't own ----------------------------------------------
  element externalSystem {
    notation 'External / third-party system'
    style {
      shape rectangle
      color gray
    }
  }

  // ==========================================================================
  //  Relationship kinds — encode the *nature* of an edge, not just its label.
  //  Style is attached so the line speaks for itself across all views.
  // ==========================================================================
  relationship sync {
    notation 'Synchronous call (HTTP/RPC/GraphQL)'
    line solid
    head normal
  }
  relationship async {
    notation 'Asynchronous (event / message)'
    line dotted
    color amber
    head vee
  }
  relationship reads {
    notation 'Reads from store'
    line dashed
    color indigo
    head vee
  }
  relationship writes {
    notation 'Writes to store'
    line solid
    color indigo
    head normal
  }
  relationship dep {
    notation 'Build / library dependency'
    line dashed
    color gray
    head open
  }

  // ==========================================================================
  //  Tags — for cross-cutting overlay views (filter the same model many ways)
  // ==========================================================================
  tag external      // anything outside the trust boundary
  tag pii {         // touches personal / sensitive data — surfaces in security views
    color #E5484D   // tag colors must be hex / rgb() — theme names (red, amber…) are not allowed here
  }
  tag deprecated {
    color #E5484D
  }
  tag public        // internet-facing entry point
  tag internal      // internal-only
  tag new           // recently added / in-flight work

  // Add team / domain tags per repo, e.g.:
  // tag team-payments
  // tag domain-billing
}
