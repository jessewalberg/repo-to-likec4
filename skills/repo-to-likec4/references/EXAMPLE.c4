// ============================================================================
//  EXAMPLE.c4  —  a complete, self-contained, VALIDATED reference
//  (passes `likec4 validate`, `build`, and `export png` on LikeC4 1.57.0)
//  Spec + model + every major view type in one file. This is the known-good
//  pattern to copy from — it deliberately demonstrates the FULL quality bar:
//    • summary (short, on the node face)  +  description (rich markdown, in the
//      click-through details panel)        ← clean faces, deep detail on click
//    • link <absolute-url> 'title'         ← "the right links": jump to source
//    • metadata { … }                      ← structured facts in the panel
//    • icon (bundled id, OR an absolute URL for brands not in the pack)
//    • lane grouping + a dedicated hub view ← how to tame hub-and-spoke
//    • navigateTo placed CORRECTLY         ← drill-down without parse errors
//    • dynamic `variant sequence`          ← flows that also render as sequences
//  In a real project: split into specification.c4 / model.c4 / views.c4 and
//  DROP this file's own `specification {}` block (use assets/specification.c4).
// ============================================================================

// ============================================================================
//  specification.c4  —  reusable, pre-styled LikeC4 vocabulary
// ----------------------------------------------------------------------------
//  COLOR SEMANTICS (do not drift between repos):
//    primary  your code  ·  secondary  human actors  ·  gray  3rd-party
//    indigo   stateful stores  ·  amber  async transport
//    green    new/healthy/highlighted  ·  red  deprecated/PII (via tags)
//    muted    de-emphasized boundary in a given view
// ============================================================================
specification {

  element person        { notation 'Person / actor'        style { shape person  color secondary } }
  element system         { notation 'System under study'     style { color primary } }
  element webapp         { notation 'Web frontend'           style { shape browser  color primary } }
  element mobileapp      { notation 'Mobile app'             style { shape mobile  color primary } }
  element service        { notation 'Service / API'          style { color primary } }
  element worker         { notation 'Background worker'       style { color primary } }
  element function       { notation 'Serverless function'    style { color primary  multiple true } }   // stacked-shape STYLE (not edge expansion)
  element gateway        { notation 'API gateway / edge'      style { color primary } }
  element component       { notation 'Component / module'      style { shape component  color primary } }
  element database        { notation 'Database'                style { shape cylinder  color indigo } }
  element cache           { notation 'Cache'                   style { shape storage  color indigo } }
  element bucket          { notation 'Object storage'          style { shape bucket  color indigo } }
  element queue           { notation 'Queue / topic / bus'     style { shape queue  color amber } }
  element externalSystem  { notation 'External / third-party'  style { color gray } }

  // Relationship kinds — encode the NATURE of an edge so the line self-explains.
  relationship sync   { notation 'Synchronous (HTTP/RPC)'  line solid   head normal }
  relationship async  { notation 'Asynchronous (event)'    line dotted  color amber   head vee }
  relationship reads  { notation 'Reads from store'        line dashed  color indigo  head vee }
  relationship writes { notation 'Writes to store'         line solid   color indigo  head normal }
  relationship dep    { notation 'Build / lib dependency'  line dashed  color gray    head open }

  tag external
  tag pii        { color #E5484D }
  tag deprecated { color #E5484D }
  tag public
  tag internal
  tag new
}

// ============================================================================
//  model.c4 — TAGS FIRST in every block (the #1 gotcha)
//  Every element carries: summary (face) + description (panel, markdown) +
//  technology + icon + link(s) to real source + metadata facts.
// ============================================================================
model {

  customer = person 'Customer' {
    summary 'Buys products in the browser'
    description '''
      End user of the storefront. Authenticates with email + password,
      browses the catalog, and places orders.
    '''
  }

  cloud = system 'Shopfront' {
    #public
    summary 'E-commerce platform'
    technology 'Kubernetes'
    icon tech:kubernetes
    description '''
      The **system under study** — a small commerce platform.
      See the [README](https://github.com/acme/shopfront#readme) and
      [architecture notes](https://github.com/acme/shopfront/blob/main/docs/architecture.md).
    '''
    link https://github.com/acme/shopfront 'Repository'
    metadata {
      owner 'platform-team'
      language 'TypeScript'
    }

    web = webapp 'Web UI' {
      summary 'React storefront (SSR)'
      technology 'Next.js'
      icon tech:react
      description '''
        Server-rendered storefront. Talks to the API over HTTPS and
        renders the catalog, cart, and checkout.
      '''
      link https://github.com/acme/shopfront/tree/main/apps/web 'Source'
      metadata { path 'apps/web'  package '@acme/web' }
    }

    api = service 'API' {
      #public
      summary 'REST API for the storefront'
      technology 'Node.js'
      icon tech:nodejs
      description '''
        Public REST API. Routes → services → repositories.
        Handles auth, catalog, cart, and order placement.
      '''
      link https://github.com/acme/shopfront/tree/main/apps/api 'Source'
      link https://github.com/acme/shopfront/blob/main/apps/api/openapi.yaml 'OpenAPI'
      metadata { path 'apps/api'  package '@acme/api' }

      // Internal components (leaves) — power the Component view AND leaf-level flows.
      apiRoutes = component 'HTTP routes' {
        summary 'Express routers + request validation'
        icon tech:nodejs
        link https://github.com/acme/shopfront/blob/main/apps/api/src/routes/index.ts#L1-L80 'routes/index.ts'
      }
      apiOrders = component 'Orders service' {
        summary 'Order placement & pricing'
        icon tech:nodejs
        link https://github.com/acme/shopfront/blob/main/apps/api/src/orders/service.ts#L1-L120 'orders/service.ts'
      }
      apiRepo = component 'Repository' {
        summary 'Data access (Prisma)'
        icon tech:prisma
        link https://github.com/acme/shopfront/blob/main/apps/api/src/db/repository.ts#L1-L60 'db/repository.ts'
      }

      apiRoutes -> apiOrders 'places order'
      apiOrders -> apiRepo 'persists'
    }

    jobs = worker 'Worker' {
      summary 'Processes OrderPlaced events'
      technology 'Node.js'
      icon tech:nodejs
      description 'Consumes events and sends receipts; updates order status.'
      link https://github.com/acme/shopfront/tree/main/apps/worker 'Source'
      metadata { path 'apps/worker' }
    }

    db = database 'Postgres' {
      #pii
      summary 'Primary datastore'
      technology 'PostgreSQL 16'
      icon tech:postgresql
      description 'Orders, customers, catalog. Contains PII (customer profile).'
      metadata { engine 'postgres'  pii 'customer profile, addresses' }
    }
    redis  = cache 'Redis'  { summary 'Sessions + cart cache'  icon tech:redis }
    events = queue 'Kafka'  { summary 'OrderPlaced topic'      icon tech:kafka }

    // edges (kinded so the line speaks for itself)
    web      -> apiRoutes 'fetches data (HTTPS)'
    apiOrders -[writes]-> db    'persists orders'
    apiOrders -[reads]->  redis 'session lookup'
    apiOrders -[async]->  events 'emit OrderPlaced'
    events   -[async]->  jobs   'OrderPlaced'
    jobs     -[writes]-> db     'updates status'
  }

  // External systems — gray, tagged #external. One has NO bundled icon, so we
  // use an ABSOLUTE brand-SVG URL (relative paths break on the published site).
  stripe = externalSystem 'Stripe' {
    #external
    summary 'Card payments'
    icon tech:stripe
    link https://stripe.com 'stripe.com'
  }
  acme = externalSystem 'Acme Mailer' {
    #external
    summary 'Transactional email'
    // no bundled icon for this vendor → official brand SVG (absolute URL):
    icon https://acme.example.com/logo.svg
  }

  customer -> web 'uses in browser'
  apiOrders -> stripe 'charge card'  { navigateTo checkoutFlow }   // edge → DYNAMIC view (correct navigateTo)
  jobs -> acme 'send receipt'
}

// ============================================================================
//  views.c4 — curated diagrams projected from the one model.
// ============================================================================
views {

  // 1) System Context — top-level only; the system as one box + its world.
  view index {
    title 'System Context'
    include *
    autoLayout TopBottom
  }

  // 2) Container map — drill into api via a view-level `with { navigateTo … }`
  //    (NOT an element-body property). Boundary muted so children pop.
  view containers of cloud {
    title 'Containers'
    include *
    include cloud.api with { navigateTo apiComponents }
    style cloud { color muted  opacity 10% }
    autoLayout LeftRight 120 130
  }

  // 3) Component view (per significant container), scoped to the container.
  view apiComponents of cloud.api {
    title 'API — components'
    include *
    include -> cloud.db, -> cloud.redis        // pull in the stores it touches
    style cloud.api { color muted  opacity 10% }
    autoLayout LeftRight
  }

  // 4) Data & persistence — filter to stores; highlight PII.
  view dataStores {
    title 'Data & persistence'
    include *
      where kind is database or kind is cache or kind is bucket
    include -> cloud.db, -> cloud.redis
    style element.tag = #pii { color red }
  }

  // 5) External integrations — group-predicate FIRST so the group ADOPTS the
  //    externals (a top-level `include *` first would leave the box EMPTY).
  view externals {
    title 'External integrations'
    group 'Third parties' {
      color gray  opacity 15%
      include * where tag is #external
    }
    include cloud.api, cloud.jobs
  }

  // 6) Key flow as a SEQUENCE — `variant sequence` + LEAF elements only.
  dynamic view checkoutFlow {
    title 'Checkout'
    variant sequence
    customer  -> web        'clicks Buy'
    web       -> apiRoutes  'POST /orders'
    apiRoutes -> apiOrders  'place order'
    apiOrders -> db         'insert order'
    par {
      apiOrders -> stripe 'charge'
      apiOrders -> events 'emit OrderPlaced'
    }
    web <- apiOrders 'returns 201'
    events -> jobs 'OrderPlaced'
    jobs -> acme 'send receipt'
  }
}
